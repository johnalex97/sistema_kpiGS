# Reemplazar únicamente en las variables protegidas de Easypanel. No subir este archivo con valores reales.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://<POSTGRES_USER>:<URL_ENCODED_POSTGRES_PASSWORD>@<PRIVATE_POSTGRES_HOST>:5432/<POSTGRES_DB>?schema=public
# Es obligatoria por la validación de configuración. Nunca ejecutar pruebas contra producción.
DATABASE_TEST_URL=postgresql://<POSTGRES_USER>:<URL_ENCODED_TEST_PASSWORD>@<PRIVATE_POSTGRES_HOST>:5432/<POSTGRES_TEST_DB>?schema=test
CORS_ORIGIN=https://<FRONTEND_TEMPORARY_DOMAIN>
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_MINUTES=480
AUTH_SESSION_IDLE_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
EVIDENCE_STORAGE_PATH=/data/evidences
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_TEMP_MAX_AGE_MINUTES=60
RECURRENCE_WARNING_DAYS=30
KPI_TIME_ZONE=America/Tegucigalpa
